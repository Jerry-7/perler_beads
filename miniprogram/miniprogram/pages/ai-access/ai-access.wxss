.ai-access-page {
  min-height: 100vh;
  padding: 28rpx;
  box-sizing: border-box;
  background: #f5f7fb;
  color: #172033;
}

.access-summary,
.redeem-panel {
  background: #ffffff;
  border: 1rpx solid #dbe3ef;
  border-radius: 12rpx;
  padding: 28rpx;
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.06);
}

.summary-kicker,
.section-heading,
.redeem-title {
  display: block;
  color: #64748b;
  font-size: 24rpx;
  font-weight: 600;
}

.summary-title {
  display: block;
  margin-top: 12rpx;
  font-size: 42rpx;
  font-weight: 800;
  color: #0f172a;
}

.summary-desc {
  display: block;
  margin-top: 12rpx;
  color: #64748b;
  font-size: 26rpx;
  line-height: 1.6;
}

.section-heading {
  margin: 32rpx 0 16rpx;
}

.package-list {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.package-card {
  height: 188rpx;
  padding: 22rpx;
  border-radius: 12rpx;
  border: 1rpx solid #cbd5e1;
  background: #ffffff;
  color: #0f172a;
  text-align: left;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  box-sizing: border-box;
}

.package-price {
  font-size: 36rpx;
  font-weight: 800;
}

.package-quota {
  color: #475569;
  font-size: 26rpx;
}

.package-action {
  align-self: flex-start;
  color: #2563eb;
  font-size: 24rpx;
  font-weight: 700;
}

.redeem-panel {
  margin-top: 28rpx;
}

.redeem-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 18rpx;
}

.redeem-input {
  flex: 1;
  height: 76rpx;
  padding: 0 20rpx;
  border-radius: 10rpx;
  border: 1rpx solid #cbd5e1;
  background: #f8fafc;
  box-sizing: border-box;
  font-size: 26rpx;
}

.redeem-button {
  width: 148rpx;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 10rpx;
  background: #172033;
  color: #ffffff;
  font-size: 26rpx;
}
