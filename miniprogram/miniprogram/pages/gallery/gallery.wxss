.gallery-page {
  min-height: 100vh;
  padding: 32rpx;
  background: #f5f7fb;
  box-sizing: border-box;
}

.empty-state {
  display: flex;
  min-height: 520rpx;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  gap: 22rpx;
  padding: 32rpx;
  border: 1rpx solid #d8dee8;
  border-radius: 8rpx;
  background: #ffffff;
}

.title {
  font-size: 44rpx;
  font-weight: 700;
  color: #111827;
}

.description {
  font-size: 28rpx;
  line-height: 1.6;
  color: #4b5563;
}

.primary {
  min-height: 72rpx;
  margin: 12rpx 0 0;
  padding: 0 28rpx;
  color: #ffffff;
  background: #2563eb;
  font-size: 28rpx;
  font-weight: 700;
}
