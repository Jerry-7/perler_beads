.page {
  padding: 20rpx;
}

.panel {
  margin-bottom: 20rpx;
  padding: 20rpx;
  border: 1rpx solid #d8dee8;
  border-radius: 8rpx;
  background: #ffffff;
}

.controls {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.primary {
  color: #ffffff;
  background: #2563eb;
}

.preview {
  height: 280rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 8rpx;
  overflow: hidden;
  background: #f8fafc;
}

.preview-image {
  width: 100%;
  height: 100%;
}

.form-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.field {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  font-size: 26rpx;
  color: #4b5563;
}

.field input {
  height: 72rpx;
  padding: 0 16rpx;
  border: 1rpx solid #d1d5db;
  border-radius: 6rpx;
  color: #111827;
  background: #ffffff;
}

.toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.title {
  font-weight: 600;
  color: #111827;
}

.actions {
  display: flex;
  gap: 12rpx;
}

.pattern-canvas {
  display: block;
  border: 1rpx solid #d1d5db;
  background: #ffffff;
}

.usage-list {
  margin-top: 14rpx;
}

.usage-row {
  display: grid;
  grid-template-columns: 40rpx 84rpx 1fr 80rpx;
  align-items: center;
  min-height: 56rpx;
  border-bottom: 1rpx solid #eef2f7;
  column-gap: 12rpx;
  font-size: 26rpx;
}

.usage-row:last-child {
  border-bottom: 0;
}

.swatch {
  width: 32rpx;
  height: 32rpx;
  border: 1rpx solid #cbd5e1;
  border-radius: 4rpx;
}

.usage-code {
  font-weight: 600;
}

.usage-name {
  color: #4b5563;
}

.usage-count {
  text-align: right;
  color: #111827;
}
