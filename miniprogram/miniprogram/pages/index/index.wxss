.maker-page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
  color: #222222;
  background: #f6f2e8;
}

.maker-hero {
  display: flex;
  min-height: 220rpx;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 28rpx;
  padding: 30rpx;
  border: 5rpx solid #333333;
  border-radius: 8rpx;
  background: #8ee6ff;
  box-shadow: 10rpx 10rpx 0 #333333;
  box-sizing: border-box;
}

.hero-copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 12rpx;
}

.hero-kicker {
  align-self: flex-start;
  padding: 6rpx 14rpx;
  border: 3rpx solid #333333;
  border-radius: 6rpx;
  font-size: 22rpx;
  font-weight: 800;
  color: #333333;
  background: #ffe56b;
}

.hero-title {
  font-size: 44rpx;
  font-weight: 900;
  line-height: 1.12;
}

.hero-subtitle {
  font-size: 25rpx;
  line-height: 1.4;
  color: #35505a;
}

.hero-button,
.generate-button,
.actions button {
  margin: 0;
  border: 4rpx solid #333333;
  border-radius: 8rpx;
  color: #ffffff;
  background: #ff6b6b;
  box-shadow: 6rpx 6rpx 0 #333333;
  font-weight: 800;
}

.hero-button {
  flex-shrink: 0;
  padding: 0 24rpx;
  font-size: 26rpx;
}

.panel {
  margin-bottom: 26rpx;
  padding: 22rpx;
  border: 4rpx solid #333333;
  border-radius: 8rpx;
  background: #ffffff;
  box-shadow: 7rpx 7rpx 0 #333333;
  box-sizing: border-box;
}

.feature-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 22rpx;
}

.feature-heading {
  margin-bottom: 0;
}

.feature-card {
  display: flex;
  min-height: 210rpx;
  flex-direction: column;
  justify-content: space-between;
  gap: 16rpx;
  padding: 24rpx;
  border: 4rpx solid #333333;
  border-radius: 8rpx;
  background: #ffffff;
  box-shadow: 7rpx 7rpx 0 #333333;
  box-sizing: border-box;
}

.feature-title {
  font-size: 34rpx;
  font-weight: 900;
  color: #222222;
}

.feature-desc {
  font-size: 25rpx;
  line-height: 1.45;
  color: #4b5563;
}

.link-button {
  margin: 0;
  padding: 0 18rpx;
  border: 3rpx solid #333333;
  border-radius: 8rpx;
  color: #333333;
  background: #ffffff;
  font-size: 23rpx;
  font-weight: 800;
  min-height: 56rpx;
}

.panel-heading,
.toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 18rpx;
}

.panel-title {
  font-size: 31rpx;
  font-weight: 900;
  color: #222222;
}

.panel-badge {
  flex-shrink: 0;
  padding: 6rpx 14rpx;
  border: 3rpx solid #333333;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 800;
  color: #333333;
  background: #b8f7d4;
}

.preview {
  display: flex;
  height: 330rpx;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border: 4rpx dashed #333333;
  border-radius: 8rpx;
  background: #fff8d6;
  box-sizing: border-box;
}

.preview.has-image {
  border-style: solid;
  background: #f8fafc;
}

.preview-image {
  width: 100%;
  height: 100%;
}

.empty-preview {
  display: flex;
  align-items: center;
  flex-direction: column;
  gap: 12rpx;
  color: #333333;
}

.empty-icon {
  display: flex;
  width: 82rpx;
  height: 82rpx;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #333333;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 5rpx 5rpx 0 #333333;
  font-size: 52rpx;
  font-weight: 900;
  line-height: 1;
}

.empty-text {
  font-size: 26rpx;
  font-weight: 800;
}

.hint-strip {
  margin-top: 16rpx;
  padding: 14rpx 16rpx;
  border: 3rpx solid #333333;
  border-radius: 8rpx;
  font-size: 24rpx;
  line-height: 1.45;
  color: #4b3f2c;
  background: #ffe56b;
}

.warning-strip {
  padding: 14rpx 16rpx;
  border: 3rpx solid #8b3f18;
  border-radius: 8rpx;
  font-size: 24rpx;
  line-height: 1.45;
  color: #4b2a16;
  background: #ffd9a6;
}


.heading-actions {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  gap: 10rpx;
}

.ai-access-strip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  padding: 14rpx 16rpx;
  border: 3rpx solid #333333;
  border-radius: 8rpx;
  background: #eef6ff;
  box-sizing: border-box;
  font-size: 24rpx;
  font-weight: 800;
  color: #1f2937;
}

.ai-access-link {
  flex-shrink: 0;
  min-height: 52rpx;
  margin: 0;
  padding: 0 14rpx;
  border: 3rpx solid #333333;
  border-radius: 8rpx;
  background: #ffe56b;
  font-size: 22rpx;
  font-weight: 900;
}
.control-panel {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.field {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 10rpx;
}

.field-label {
  font-size: 25rpx;
  font-weight: 800;
  color: #333333;
}

.field-hint {
  display: block;
  font-size: 20rpx;
  color: #94a3b8;
  margin-top: 4rpx;
  margin-bottom: 8rpx;
}

.form-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.field input,
.picker-field {
  height: 76rpx;
  padding: 0 18rpx;
  border: 3rpx solid #333333;
  border-radius: 8rpx;
  box-sizing: border-box;
  color: #111827;
  background: #ffffff;
  font-size: 27rpx;
  font-weight: 700;
}

.picker-field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.picker-arrow {
  flex-shrink: 0;
  font-size: 20rpx;
  color: #ff6b6b;
}

.source-switch {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
}

.source-option {
  height: 70rpx;
  margin: 0;
  border: 3rpx solid #333333;
  border-radius: 8rpx;
  color: #333333;
  background: #ffffff;
  font-size: 25rpx;
  font-weight: 800;
}

.source-option.active {
  color: #111827;
  background: #b8f7d4;
  box-shadow: 4rpx 4rpx 0 #333333;
}

.generate-button {
  height: 88rpx;
  margin-top: 6rpx;
  background: #2f6df6;
  font-size: 31rpx;
}

.secondary-button {
  height: 76rpx;
  margin: 0;
  border: 4rpx solid #333333;
  border-radius: 8rpx;
  color: #333333;
  background: #ffe56b;
  box-shadow: 5rpx 5rpx 0 #333333;
  font-size: 27rpx;
  font-weight: 800;
}

.compact-button {
  height: 68rpx;
  font-size: 25rpx;
}

.panel-action-button {
  width: 100%;
  margin-top: 18rpx;
}

.generate-button[disabled],
.secondary-button[disabled] {
  color: #333333;
  background: #d7d7d7;
  opacity: 1;
}

.progress-block {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.progress-track {
  overflow: hidden;
  height: 28rpx;
  border: 3rpx solid #333333;
  border-radius: 999rpx;
  background: #ffffff;
}

.progress-fill {
  height: 100%;
  border-right: 3rpx solid #333333;
  background: #b8f7d4;
  transition: width 0.25s ease;
}

.progress-text {
  font-size: 24rpx;
  font-weight: 800;
  color: #35505a;
}

.result-panel {
  overflow: hidden;
}

.debug-panel {
  overflow: hidden;
}

.debug-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-bottom: 18rpx;
}

.recommend-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
}

.recommend-card {
  padding: 14rpx;
  border: 3rpx solid #333333;
  border-radius: 8rpx;
  background: #fff8d6;
  box-sizing: border-box;
}

.debug-stat,
.debug-preview-card {
  padding: 14rpx;
  border: 3rpx solid #333333;
  border-radius: 8rpx;
  background: #fff8d6;
  box-sizing: border-box;
}

.debug-label {
  display: block;
  margin-bottom: 8rpx;
  font-size: 23rpx;
  font-weight: 800;
  color: #5f574d;
}

.debug-value {
  font-size: 26rpx;
  font-weight: 900;
  color: #111827;
}

.debug-preview-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
}

.debug-preview-image {
  width: 100%;
  height: 260rpx;
  border: 3rpx solid #333333;
  background: #ffffff;
  box-sizing: border-box;
}

.result-title-group {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 4rpx;
}

.result-size {
  font-size: 24rpx;
  font-weight: 800;
  color: #5f574d;
}

.actions {
  display: flex;
  flex-shrink: 0;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 12rpx;
}

.actions button {
  min-height: 58rpx;
  padding: 0 16rpx;
  color: #333333;
  background: #ffe56b;
  font-size: 23rpx;
}

.tracing-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 16rpx;
  padding: 14rpx 16rpx;
  border: 3rpx solid #333333;
  border-radius: 8rpx;
  background: #eef6ff;
  box-sizing: border-box;
}

.tracing-status {
  min-width: 0;
  flex: 1;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.35;
  color: #1f2937;
}

.trace-mark-switch {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  gap: 10rpx;
  font-size: 23rpx;
  font-weight: 800;
  color: #333333;
}

.canvas-frame {
  position: relative;
  overflow: auto;
  width: 100%;
  max-width: 100%;
  max-height: 72vh;
  padding: 10rpx;
  border: 4rpx solid #333333;
  border-radius: 8rpx;
  background: #f8fafc;
  box-sizing: border-box;
}

.pattern-canvas {
  display: block;
  flex-shrink: 0;
  background: #ffffff;
}

.zoom-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding: 12rpx;
  border: 3rpx solid #333333;
  border-radius: 8rpx;
  background: #ffffff;
}

.zoom-label {
  min-width: 0;
  font-size: 23rpx;
  font-weight: 900;
  color: #222222;
}

.zoom-actions {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  gap: 8rpx;
}

.zoom-actions button {
  min-width: 68rpx;
  min-height: 58rpx;
  margin: 0;
  padding: 0 12rpx;
  border: 3rpx solid #333333;
  border-radius: 8rpx;
  background: #ffe56b;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 52rpx;
}

.edit-popover {
  display: flex;
  width: 100%;
  margin-top: 16rpx;
  flex-direction: column;
  gap: 12rpx;
  padding: 16rpx;
  border: 4rpx solid #333333;
  border-radius: 8rpx;
  background: #ffffff;
  box-shadow: 6rpx 6rpx 0 #333333;
  box-sizing: border-box;
}

.pattern-editor-fullscreen {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  height: 100vh;
  max-height: 100vh;
  flex-direction: column;
  gap: 12rpx;
  overflow: hidden;
  padding: 18rpx;
  background: #eef2f7;
  box-sizing: border-box;
}

.editor-topbar,
.editor-tool-panel,
.editor-color-panel {
  flex-shrink: 0;
  border: 4rpx solid #333333;
  border-radius: 8rpx;
  background: #ffffff;
  box-shadow: 5rpx 5rpx 0 #333333;
  box-sizing: border-box;
}

.editor-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 12rpx 14rpx;
}

.editor-title-group {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 4rpx;
}

.editor-title {
  font-size: 30rpx;
  font-weight: 900;
  color: #222222;
}

.editor-subtitle {
  overflow: hidden;
  font-size: 22rpx;
  font-weight: 800;
  color: #4b5563;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.editor-close {
  flex-shrink: 0;
  min-height: 58rpx;
  margin: 0;
  padding: 0 18rpx;
  border: 3rpx solid #333333;
  border-radius: 8rpx;
  background: #ffe56b;
  font-size: 23rpx;
  font-weight: 900;
}

.editor-tool-panel {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  padding: 12rpx;
}

.editor-tool-row {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 8rpx;
}

.editor-tool-row.secondary {
  grid-template-columns: repeat(5, 1fr);
}

.editor-tool {
  display: flex;
  min-width: 0;
  min-height: 54rpx;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0 8rpx;
  border: 3rpx solid #333333;
  border-radius: 8rpx;
  color: #222222;
  background: #ffffff;
  font-size: 21rpx;
  font-weight: 900;
  line-height: 1;
}

.editor-tool.active {
  color: #ffffff;
  background: #2f6df6;
}

.editor-tool[disabled] {
  color: #64748b;
  background: #e5e7eb;
  opacity: 1;
}

.editor-canvas-frame {
  position: relative;
  display: flex;
  flex: 1;
  min-height: 0;
  width: 100%;
  max-width: 100%;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border: 4rpx solid #333333;
  border-radius: 8rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.editor-pattern-canvas {
  display: block;
  max-width: 100%;
  max-height: 100%;
  background: #f8fafc;
  touch-action: none;
}

.editor-color-panel {
  display: flex;
  max-height: 34vh;
  flex-direction: column;
  gap: 10rpx;
  padding: 14rpx;
}

.edit-panel-content {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.edit-title-group {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 2rpx;
}

.edit-popover-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.edit-title,
.edit-section-title {
  font-size: 23rpx;
  font-weight: 900;
  color: #222222;
}

.edit-head-actions {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  gap: 8rpx;
}

.edit-close {
  min-height: 44rpx;
  margin: 0;
  padding: 0 12rpx;
  border: 3rpx solid #333333;
  border-radius: 8rpx;
  background: #ffffff;
  font-size: 20rpx;
  font-weight: 800;
}

.edit-current {
  overflow: hidden;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1.25;
  color: #64748b;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.edit-batch-status {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
  padding: 10rpx;
  border: 3rpx solid #2f6df6;
  border-radius: 8rpx;
  background: #eef6ff;
  box-sizing: border-box;
  font-size: 20rpx;
  font-weight: 900;
  color: #1f2937;
}

.edit-candidate-section,
.edit-palette-dropdown {
  min-width: 0;
  padding: 10rpx;
  border: 3rpx solid #333333;
  border-radius: 8rpx;
  background: #f8fafc;
  box-sizing: border-box;
}

.edit-section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
  margin-bottom: 8rpx;
}

.edit-section-note {
  min-width: 0;
  overflow: hidden;
  font-size: 18rpx;
  font-weight: 800;
  color: #64748b;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.edit-candidate-strip {
  width: 100%;
  white-space: nowrap;
}

.edit-candidate-chip {
  display: inline-flex;
  min-width: 140rpx;
  min-height: 66rpx;
  align-items: center;
  justify-content: flex-start;
  gap: 10rpx;
  margin: 0 10rpx 0 0;
  padding: 0 12rpx;
  border: 3rpx solid #333333;
  border-radius: 8rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.edit-candidate-chip.active {
  background: #dbeafe;
  box-shadow: inset 0 0 0 3rpx #2f6df6;
}

.edit-candidate-swatch,
.edit-swatch {
  flex-shrink: 0;
  width: 34rpx;
  height: 34rpx;
  border: 2rpx solid #333333;
  border-radius: 6rpx;
}

.edit-candidate-text {
  display: flex;
  min-width: 0;
  flex-direction: column;
  align-items: flex-start;
  gap: 2rpx;
}

.edit-candidate-code {
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1;
}

.edit-candidate-count {
  font-size: 18rpx;
  font-weight: 800;
  line-height: 1;
  color: #64748b;
}

.edit-candidate-focus {
  margin-top: 2rpx;
  padding: 2rpx 8rpx;
  border: 2rpx solid #333333;
  border-radius: 6rpx;
  font-size: 16rpx;
  font-weight: 900;
  line-height: 1.2;
  color: #1f2937;
  background: #ffe56b;
}

.edit-dropdown-toggle {
  display: flex;
  width: 100%;
  min-height: 52rpx;
  align-items: center;
  justify-content: space-between;
  margin: 0;
  padding: 0 10rpx;
  border: 3rpx solid #333333;
  border-radius: 8rpx;
  background: #ffffff;
  box-sizing: border-box;
  font-size: 21rpx;
  font-weight: 900;
}

.edit-dropdown-state {
  color: #64748b;
  font-size: 19rpx;
}

.edit-dropdown-list {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-top: 8rpx;
}

.edit-search {
  height: 52rpx;
  padding: 0 10rpx;
  border: 3rpx solid #333333;
  border-radius: 8rpx;
  box-sizing: border-box;
  font-size: 20rpx;
  font-weight: 700;
  background: #ffffff;
}

.edit-search-list {
  display: flex;
  max-height: 190rpx;
  flex-direction: column;
  gap: 8rpx;
  overflow: auto;
}

.edit-search-row {
  display: flex;
  min-width: 0;
  min-height: 54rpx;
  align-items: center;
  justify-content: flex-start;
  gap: 8rpx;
  margin: 0;
  padding: 0 10rpx;
  border: 3rpx solid #333333;
  border-radius: 8rpx;
  background: #ffffff;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1;
}

.edit-search-code {
  flex-shrink: 0;
  font-weight: 900;
}

.edit-search-name {
  min-width: 0;
  overflow: hidden;
  color: #4b5563;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.result-meta-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14rpx;
  margin-top: 18rpx;
}

.result-meta-card {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 6rpx;
  padding: 14rpx;
  border: 3rpx solid #333333;
  border-radius: 8rpx;
  background: #fff8d6;
  box-sizing: border-box;
}

.result-meta-label {
  font-size: 22rpx;
  font-weight: 800;
  color: #5f574d;
}

.result-meta-value {
  font-size: 28rpx;
  font-weight: 900;
  color: #111827;
}

.result-usage-section {
  margin-top: 18rpx;
}

.usage-heading {
  margin-bottom: 12rpx;
}

.usage-list {
  overflow: hidden;
  border: 3rpx solid #333333;
  border-radius: 8rpx;
}

.usage-row {
  display: grid;
  grid-template-columns: 42rpx 90rpx minmax(0, 1fr) 72rpx;
  align-items: center;
  min-height: 64rpx;
  padding: 0 14rpx;
  border-bottom: 3rpx solid #333333;
  column-gap: 12rpx;
  font-size: 25rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.usage-row:nth-child(2n) {
  background: #fff8d6;
}

.usage-row:last-child {
  border-bottom: 0;
}

.swatch {
  width: 34rpx;
  height: 34rpx;
  border: 3rpx solid #333333;
  border-radius: 6rpx;
}

.usage-code {
  font-weight: 900;
}

.usage-name {
  overflow: hidden;
  color: #4b5563;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.usage-count {
  text-align: right;
  font-weight: 900;
  color: #111827;
}

@media (max-width: 420px) {
  .edit-panel-content {
    grid-template-columns: 1fr;
  }
}
