<view class="maker-page">
  <view class="maker-hero">
    <view class="hero-copy">
      <text class="hero-kicker">制作工具</text>
      <text class="hero-title">照片变拼豆图纸</text>
      <text class="hero-subtitle">选择图片，调整尺寸和颜色复杂度</text>
    </view>
    <button class="hero-button" bindtap="chooseImage">{{imagePath ? "重新选图" : "选择图片"}}</button>
  </view>

  <view class="panel upload-panel">
    <view class="panel-heading">
      <text class="panel-title">图片预览</text>
      <text class="panel-badge">{{imagePath ? "已选择" : "待选择"}}</text>
    </view>
    <view class="preview {{imagePath ? 'has-image' : ''}}" bindtap="chooseImage">
      <image wx:if="{{imagePath}}" class="preview-image" src="{{imagePath}}" mode="aspectFit" />
      <view wx:else class="empty-preview">
        <text class="empty-icon">+</text>
        <text class="empty-text">点击添加照片</text>
      </view>
    </view>
    <view wx:if="{{isRecommendingSize || sizeRecommendationText}}" class="hint-strip">
      <text wx:if="{{isRecommendingSize}}">正在计算推荐格数...</text>
      <text wx:else>{{sizeRecommendationText}}</text>
    </view>
  </view>

  <view class="panel control-panel">
    <view class="panel-heading">
      <text class="panel-title">公共参数</text>
      <text class="panel-badge">最多 {{aiMaxColors || 16}} 色</text>
    </view>

    <label class="field">
      <text class="field-label">最大颜色数（4-64）</text>
      <input type="number" value="{{aiMaxColors}}" bindinput="onAiMaxColorsInput" />
    </label>
  </view>

  <view class="panel control-panel">
    <view class="panel-heading">
      <text class="panel-title">图纸参数</text>
      <text class="panel-badge">{{widthCells}} x {{heightCells}}</text>
    </view>

    <label class="field">
      <text class="field-label">AI生成精细度</text>
      <picker mode="selector" range="{{aiDetailOptions}}" range-key="label" value="{{aiDetailIndex}}" bindchange="onAiDetailChange">
        <view class="picker-field">
          <text>{{aiDetailOptions[aiDetailIndex].label}}</text>
          <text class="picker-arrow">▼</text>
        </view>
      </picker>
    </label>

    <label class="field">
      <text class="field-label">生图取向</text>
      <picker mode="selector" range="{{aiStyleOptions}}" range-key="label" value="{{aiStyleIndex}}" bindchange="onAiStyleChange">
        <view class="picker-field">
          <text>{{aiStyleOptions[aiStyleIndex].label}}</text>
          <text class="picker-arrow">▼</text>
        </view>
      </picker>
    </label>

    <view class="form-grid">
      <label class="field">
        <text class="field-label">3D效果</text>
        <picker mode="selector" range="{{aiEffect3dOptions}}" range-key="label" value="{{aiEffect3dIndex}}" bindchange="onAiEffect3dChange">
          <view class="picker-field">
            <text>{{aiEffect3dOptions[aiEffect3dIndex].label}}</text>
            <text class="picker-arrow">▼</text>
          </view>
        </picker>
      </label>
      <label class="field">
        <text class="field-label">阴影方式</text>
        <picker mode="selector" range="{{aiShadingOptions}}" range-key="label" value="{{aiShadingIndex}}" bindchange="onAiShadingChange">
          <view class="picker-field">
            <text>{{aiShadingOptions[aiShadingIndex].label}}</text>
            <text class="picker-arrow">▼</text>
          </view>
        </picker>
      </label>
    </view>

    <button class="generate-button" loading="{{isGeneratingAiImage}}" disabled="{{!canGenerate || isGeneratingAiImage}}" bindtap="generateAiImage">
      {{aiImageId ? "重新生成 AI 图" : "生成 AI 预览图"}}
    </button>

    <view wx:if="{{isGeneratingAiImage || aiImageProgress}}" class="progress-block">
      <view class="progress-track">
        <view class="progress-fill" style="width: {{aiImageProgress}}%;"></view>
      </view>
      <text class="progress-text">{{aiImageProgressText}} {{aiImageProgress}}%</text>
    </view>
  </view>

  <view wx:if="{{aiImagePath}}" class="panel upload-panel">
    <view class="panel-heading">
      <text class="panel-title">AI 预览图</text>
      <text class="panel-badge">可图纸化</text>
    </view>
    <view class="preview has-image">
      <image class="preview-image" src="{{aiImagePath}}" mode="aspectFit" />
    </view>
    <button class="secondary-button panel-action-button" bindtap="saveAiImageToAlbum">保存到相册</button>
  </view>

  <view class="panel control-panel">
    <view class="panel-heading">
      <text class="panel-title">图纸调整</text>
      <text class="panel-badge">{{patternSource === "ai" ? (aiImageId ? "AI 图已就绪" : "先生成 AI 图") : (imagePath ? "原图已就绪" : "先选择图片")}}</text>
    </view>
    <view class="hint-strip">图纸最多保留 {{aiMaxColors || 16}} 种颜色，会影响最终拼豆色号数量。</view>

    <view class="field">
      <text class="field-label">图纸来源</text>
      <view class="source-switch">
        <button
          class="source-option {{patternSource === 'original' ? 'active' : ''}}"
          size="mini"
          bindtap="selectOriginalPatternSource"
        >
          原上传图
        </button>
        <button
          class="source-option {{patternSource === 'ai' ? 'active' : ''}}"
          size="mini"
          bindtap="selectAiPatternSource"
        >
          AI 预览图
        </button>
      </view>
    </view>

    <label class="field">
      <text class="field-label">目标尺寸</text>
      <picker mode="selector" range="{{patternSizeOptions}}" range-key="label" value="{{patternSizeIndex}}" bindchange="onPatternSizeChange">
        <view class="picker-field">
          <text>{{patternSizeOptions[patternSizeIndex].label}}</text>
          <text class="picker-arrow">▼</text>
        </view>
      </picker>
    </label>

    <view wx:if="{{isCustomSize}}" class="form-grid">
      <label class="field">
        <text class="field-label">宽度格数</text>
        <input type="number" value="{{widthCells}}" bindinput="onWidthInput" />
      </label>
      <label class="field">
        <text class="field-label">高度格数</text>
        <input type="number" value="{{heightCells}}" bindinput="onHeightInput" />
      </label>
    </view>

    <label class="field">
      <text class="field-label">图纸效果</text>
      <picker mode="selector" range="{{samplingModeOptions}}" range-key="label" value="{{samplingModeIndex}}" bindchange="onSamplingModeChange">
        <view class="picker-field">
          <text>{{samplingModeOptions[samplingModeIndex].label}}</text>
          <text class="picker-arrow">▼</text>
        </view>
      </picker>
    </label>

    <label class="field">
      <text class="field-label">颜色复杂度</text>
      <picker mode="selector" range="{{colorComplexityOptions}}" range-key="label" value="{{colorComplexityIndex}}" bindchange="onColorComplexityChange">
        <view class="picker-field">
          <text>{{colorComplexityOptions[colorComplexityIndex].label}}</text>
          <text class="picker-arrow">▼</text>
        </view>
      </picker>
    </label>

    <button
      class="generate-button"
      loading="{{isGenerating}}"
      disabled="{{isGenerating || (patternSource === 'ai' ? !aiImageId : !imagePath)}}"
      bindtap="generatePattern"
    >
      生成拼豆图纸
    </button>
    <button
      class="secondary-button"
      loading="{{isAnalyzingPattern}}"
      disabled="{{isAnalyzingPattern || !imagePath}}"
      bindtap="analyzePatternStages"
    >
      查看识别过程
    </button>
  </view>

  <view wx:if="{{patternDebug}}" class="panel debug-panel">
    <view class="panel-heading">
      <text class="panel-title">识别过程</text>
      <text class="panel-badge">{{patternDebug.compressedGridWidth}} x {{patternDebug.compressedGridHeight}}</text>
    </view>
    <view class="debug-grid">
      <view class="debug-stat">
        <text class="debug-label">源图尺寸</text>
        <text class="debug-value">{{patternDebug.sourceWidth}} x {{patternDebug.sourceHeight}}</text>
      </view>
      <view class="debug-stat">
        <text class="debug-label">识别像素块</text>
        <text class="debug-value">{{patternDebug.detectedBlockWidth || '-'}} x {{patternDebug.detectedBlockHeight || '-'}}</text>
      </view>
      <view class="debug-stat">
        <text class="debug-label">原始像素格</text>
        <text class="debug-value">{{patternDebug.detectedGridWidth}} x {{patternDebug.detectedGridHeight}} / {{patternDebug.detectedPixelCount}}</text>
      </view>
      <view class="debug-stat">
        <text class="debug-label">压缩后像素格</text>
        <text class="debug-value">{{patternDebug.compressedGridWidth}} x {{patternDebug.compressedGridHeight}} / {{patternDebug.compressedPixelCount}}</text>
      </view>
    </view>
    <view class="debug-preview-grid">
      <view class="debug-preview-card">
        <text class="debug-label">原始识别图</text>
        <image class="debug-preview-image" src="{{patternDebug.originalPreviewDataUrl}}" mode="aspectFit" />
      </view>
      <view class="debug-preview-card">
        <text class="debug-label">压缩后图片</text>
        <image class="debug-preview-image" src="{{patternDebug.compressedPreviewDataUrl}}" mode="aspectFit" />
      </view>
    </view>
  </view>

  <view wx:if="{{result}}" class="panel result-panel">
    <view class="toolbar">
      <view class="result-title-group">
        <text class="panel-title">生成图纸</text>
        <text class="result-size">{{result.widthCells}} x {{result.heightCells}}</text>
      </view>
      <view class="actions">
        <button size="mini" bindtap="previewPattern">预览图纸</button>
        <button size="mini" bindtap="exportPng">保存到相册</button>
      </view>
    </view>
    <view class="canvas-frame">
      <canvas
        class="pattern-canvas"
        type="2d"
        id="patternCanvas"
        style="width: {{canvasCssWidth}}px; height: {{canvasCssHeight}}px;"
      ></canvas>
    </view>
  </view>

  <view wx:if="{{usage.length}}" class="panel usage-panel">
    <view class="panel-heading">
      <text class="panel-title">色号统计</text>
      <text class="panel-badge">{{usage.length}} 色</text>
    </view>
    <view class="usage-list">
      <view wx:for="{{usage}}" wx:key="beadCode" class="usage-row">
        <view class="swatch" style="background: rgb({{item.beadRgb[0]}}, {{item.beadRgb[1]}}, {{item.beadRgb[2]}});"></view>
        <text class="usage-code">{{item.beadCode}}</text>
        <text class="usage-name">{{item.beadName}}</text>
        <text class="usage-count">{{item.count}}</text>
      </view>
    </view>
  </view>
</view>
