  <view class="maker-hero">
    <view class="hero-copy">
      <text class="hero-kicker">制作</text>
      <text class="hero-title">图片转拼豆图纸</text>
      <text class="hero-subtitle">可以先用 AI 生图，也可以直接上传图片生成图纸。</text>
    </view>
  </view>

  <view wx:if="{{activeTool === 'home'}}" class="feature-grid">
    <view class="panel-heading feature-heading">
      <text class="panel-title">开始</text>
      <text class="panel-badge">选择方式</text>
    </view>
    <view class="feature-card" bindtap="openAiTool">
      <text class="feature-title">AI 生图</text>
      <text class="feature-desc">先生成更适合拼豆的图片。</text>
      <button class="secondary-button panel-action-button">进入</button>
    </view>
    <view class="feature-card" bindtap="openPatternTool">
      <text class="feature-title">生成图纸</text>
      <text class="feature-desc">上传图片后设置尺寸、颜色和图纸效果。</text>
      <button class="secondary-button panel-action-button">进入</button>
    </view>
  </view>

  <view wx:if="{{activeTool === 'ai'}}" class="panel control-panel">
    <view class="panel-heading">
      <text class="panel-title">AI 生图设置</text>
      <view class="heading-actions">
        <button class="link-button" size="mini" bindtap="openAiAccessPage">权限码</button>
        <button class="link-button" size="mini" bindtap="backToToolHome">返回</button>
      </view>
    </view>

    <view class="preview {{imagePath ? 'has-image' : ''}}" bindtap="chooseImage">
      <image wx:if="{{imagePath}}" class="preview-image" src="{{imagePath}}" mode="aspectFit" />
      <view wx:else class="empty-preview">
        <text class="empty-icon">+</text>
        <text class="empty-text">上传图片</text>
      </view>
    </view>

    <label class="field">
      <text class="field-label">预选图纸尺寸</text>
      <picker mode="selector" range="{{patternSizeOptions}}" range-key="label" value="{{patternSizeIndex}}" bindchange="onPatternSizeChange">
        <view class="picker-field">
          <text>{{patternSizeOptions[patternSizeIndex].label}}</text>
          <text class="picker-arrow">v</text>
        </view>
      </picker>
    </label>

    <view wx:if="{{isCustomSize}}" class="form-grid">
      <label class="field">
        <text class="field-label">宽度格数</text>
        <input type="number" value="{{widthCells}}" bindinput="onWidthInput" />
      </label>
      <label class="field">
        <text class="field-label">高度格数</text>
        <input type="number" value="{{heightCells}}" bindinput="onHeightInput" />
      </label>
    </view>

    <label class="field">
      <text class="field-label">AI 精细度</text>
      <picker mode="selector" range="{{aiDetailOptions}}" range-key="label" value="{{aiDetailIndex}}" bindchange="onAiDetailChange">
        <view class="picker-field">
          <text>{{aiDetailOptions[aiDetailIndex].label}}</text>
          <text class="picker-arrow">v</text>
        </view>
      </picker>
    </label>

    <label class="field">
      <text class="field-label">生图取向</text>
      <picker mode="selector" range="{{aiStyleOptions}}" range-key="label" value="{{aiStyleIndex}}" bindchange="onAiStyleChange">
        <view class="picker-field">
          <text>{{aiStyleOptions[aiStyleIndex].label}}</text>
          <text class="picker-arrow">v</text>
        </view>
      </picker>
    </label>

    <view class="form-grid">
      <label class="field">
        <text class="field-label">3D 效果</text>
        <picker mode="selector" range="{{aiEffect3dOptions}}" range-key="label" value="{{aiEffect3dIndex}}" bindchange="onAiEffect3dChange">
          <view class="picker-field">
            <text>{{aiEffect3dOptions[aiEffect3dIndex].label}}</text>
            <text class="picker-arrow">v</text>
          </view>
        </picker>
      </label>
      <label class="field">
        <text class="field-label">阴影方式</text>
        <picker mode="selector" range="{{aiShadingOptions}}" range-key="label" value="{{aiShadingIndex}}" bindchange="onAiShadingChange">
          <view class="picker-field">
            <text>{{aiShadingOptions[aiShadingIndex].label}}</text>
            <text class="picker-arrow">v</text>
          </view>
        </picker>
      </label>
    </view>

    <view class="ai-access-strip">
      <text>{{aiAccessText}}</text>
      <button size="mini" class="ai-access-link" bindtap="openAiAccessPage">权限码</button>
    </view>

    <button class="generate-button" loading="{{isGeneratingAiImage}}" disabled="{{!imagePath || isGeneratingAiImage}}" bindtap="generateAiImage">
      <text wx:if="{{aiImageId}}">重新生成 AI 图</text>
      <text wx:else>生成 AI 图</text>
    </button>

    <view wx:if="{{isGeneratingAiImage || aiImageProgress}}" class="progress-block">
      <view class="progress-track">
        <view class="progress-fill" style="width: {{aiImageProgress}}%;"></view>
      </view>
      <text class="progress-text">{{aiImageProgressText}} {{aiImageProgress}}%</text>
    </view>
  </view>

  <view wx:if="{{activeTool === 'ai' && aiImagePath}}" class="panel upload-panel">
    <view class="panel-heading">
      <text class="panel-title">AI 结果</text>
      <text class="panel-badge">已生成</text>
    </view>
    <view class="preview has-image">
      <image class="preview-image" src="{{aiImagePath}}" mode="aspectFit" />
    </view>
    <button class="secondary-button panel-action-button" bindtap="saveAiImageToAlbum">保存到相册</button>
    <button class="generate-button" bindtap="useAiImageForPattern">用这张图生成图纸</button>
  </view>

  <view wx:if="{{activeTool === 'pattern'}}" class="panel control-panel">
    <view class="panel-heading">
      <text class="panel-title">图纸设置</text>
      <button class="link-button" size="mini" bindtap="backToToolHome">返回</button>
    </view>

    <view class="preview {{patternSource === 'ai' && aiImagePath || imagePath ? 'has-image' : ''}}" bindtap="chooseImage">
      <image wx:if="{{patternSource === 'ai' && aiImagePath}}" class="preview-image" src="{{aiImagePath}}" mode="aspectFit" />
      <image wx:elif="{{imagePath}}" class="preview-image" src="{{imagePath}}" mode="aspectFit" />
      <view wx:else class="empty-preview">
        <text class="empty-icon">+</text>
        <text class="empty-text">上传图片</text>
      </view>
    </view>

    <view wx:if="{{isRecommendingSize || sizeRecommendationText}}" class="hint-strip">
      <text wx:if="{{isRecommendingSize}}">正在计算推荐参数...</text>
      <text wx:else>{{sizeRecommendationText}}</text>
    </view>

    <view class="recommend-grid">
      <view class="recommend-card">
        <text class="debug-label">推荐尺寸</text>
        <text class="debug-value">{{recommendedSizeText}}</text>
      </view>
      <view class="recommend-card">
        <text class="debug-label">推荐颜色数</text>
        <text class="debug-value">{{recommendedColors || '-'}}</text>
      </view>
    </view>
    <button class="secondary-button compact-button" disabled="{{!recommendedWidthCells || !recommendedHeightCells}}" bindtap="applyRecommendedPatternSize">套用推荐</button>
    <view wx:if="{{patternSizeWarning}}" class="warning-strip">
      <text>{{patternSizeWarning}}</text>
    </view>

    <view class="field">
      <text class="field-label">图片来源</text>
      <view class="source-switch">
        <button class="source-option {{patternSource === 'original' ? 'active' : ''}}" size="mini" bindtap="selectOriginalPatternSource">上传</button>
        <button class="source-option {{patternSource === 'ai' ? 'active' : ''}}" size="mini" bindtap="selectAiPatternSource" disabled="{{!aiImageId}}">AI</button>
      </view>
    </view>

    <label class="field">
      <text class="field-label">目标尺寸</text>
      <picker mode="selector" range="{{patternSizeOptions}}" range-key="label" value="{{patternSizeIndex}}" bindchange="onPatternSizeChange">
        <view class="picker-field">
          <text>{{patternSizeOptions[patternSizeIndex].label}}</text>
          <text class="picker-arrow">v</text>
        </view>
      </picker>
    </label>

    <view wx:if="{{isCustomSize}}" class="form-grid">
      <label class="field">
        <text class="field-label">宽度格数</text>
        <input type="number" value="{{widthCells}}" bindinput="onWidthInput" />
      </label>
      <label class="field">
        <text class="field-label">高度格数</text>
        <input type="number" value="{{heightCells}}" bindinput="onHeightInput" />
      </label>
    </view>

    <label class="field">
      <text class="field-label">颜色复杂度</text>
      <picker mode="selector" range="{{colorComplexityOptions}}" range-key="label" value="{{colorComplexityIndex}}" bindchange="onColorComplexityChange">
        <view class="picker-field">
          <text>{{colorComplexityOptions[colorComplexityIndex].label}}</text>
          <text class="picker-arrow">v</text>
        </view>
      </picker>
    </label>

    <label class="field">
      <text class="field-label">图纸效果</text>
      <picker mode="selector" range="{{samplingModeOptions}}" range-key="label" value="{{samplingModeIndex}}" bindchange="onSamplingModeChange">
        <view class="picker-field">
          <text>{{samplingModeOptions[samplingModeIndex].label}}</text>
          <text class="picker-arrow">v</text>
        </view>
      </picker>
    </label>

    <view wx:if="{{samplingMode === 'cluster-ms'}}" class="field">
      <text class="field-label">合并力度 ({{clusterQuantile}})</text>
      <text class="field-hint">越小合并越激进，颜色越少</text>
      <slider min="5" max="40" step="1" value="{{clusterQuantileSlider}}" activeColor="#6366f1" block-size="16" bindchange="onClusterQuantileChange" />
    </view>

    <view wx:if="{{samplingMode === 'cluster-dbscan'}}" class="field">
      <text class="field-label">颜色距离阈值 ({{clusterEps}})</text>
      <text class="field-hint">越小保留颜色越多，越大合并越多</text>
      <slider min="10" max="60" step="1" value="{{clusterEps}}" activeColor="#f59e0b" block-size="16" bindchange="onClusterEpsChange" />
    </view>

    <view class="field">
      <text class="field-label">最大颜色数 ({{patternMaxColors}})</text>
      <slider min="4" max="64" step="1" value="{{patternMaxColors}}" activeColor="#10b981" block-size="16" bindchange="onPatternMaxColorsChange" />
    </view>

    <button class="generate-button" loading="{{isGenerating}}" disabled="{{isGenerating || (patternSource === 'ai' ? !aiImageId : !imagePath)}}" bindtap="generatePattern">
      生成图纸
    </button>
  </view>

  <view wx:if="{{result}}" class="panel result-panel">
    <view class="result-heading">
      <view>
        <text class="panel-title">图纸结果</text>
        <text class="result-size">{{result.widthCells}} x {{result.heightCells}}</text>
      </view>
      <view class="actions">
        <button size="mini" bindtap="toggleTracingMode">
          <text wx:if="{{isTracingMode}}">退出临摹</text>
          <text wx:else>临摹模式</text>
        </button>
        <button size="mini" bindtap="toggleEditingMode">
          <text wx:if="{{isEditingMode}}">退出修改</text>
          <text wx:else>修改图纸</text>
        </button>
        <button size="mini" bindtap="previewPattern">预览</button>
        <button size="mini" bindtap="exportPng">保存</button>
      </view>
    </view>
    <view wx:if="{{isTracingMode}}" class="tracing-bar">
      <text class="tracing-status">{{traceStatusText}}</text>
      <label class="trace-mark-switch">
        <text>标记</text>
        <switch checked="{{traceMarkEnabled}}" color="#2f6df6" bindchange="toggleTraceMarkEnabled" />
      </label>
    </view>
    <view wx:if="{{isEditingMode}}" class="zoom-bar">
      <text class="zoom-label">缩放 {{patternZoomText}}</text>
      <view class="zoom-actions">
        <button size="mini" bindtap="zoomPatternOut">-</button>
        <button size="mini" bindtap="resetPatternZoom">100%</button>
        <button size="mini" bindtap="zoomPatternIn">+</button>
      </view>
    </view>
    <scroll-view wx:if="{{!isEditingMode}}" class="canvas-frame" scroll-x="true" scroll-y="true" enhanced="true" show-scrollbar="true">
      <canvas
        class="pattern-canvas"
        type="2d"
        id="patternCanvas"
        style="width: {{canvasCssWidth}}px; height: {{canvasCssHeight}}px;"
        bindmousemove="onPatternPointerMove"
        bindtouchstart="onPatternTouchStart"
        bindtouchmove="onPatternTouchMove"
        bindtouchend="onPatternTouchEnd"
        bindtap="onPatternTap"
        bindlongpress="onPatternTap"
      ></canvas>
    </scroll-view>

    <view class="result-meta-grid">
      <view class="result-meta-card">
        <text class="result-meta-label">行数</text>
        <text class="result-meta-value">{{result.heightCells}} 行</text>
      </view>
      <view class="result-meta-card">
        <text class="result-meta-label">列数</text>
        <text class="result-meta-value">{{result.widthCells}} 列</text>
      </view>
      <view class="result-meta-card">
        <text class="result-meta-label">颜色</text>
        <text class="result-meta-value">{{usage.length}} 色</text>
      </view>
      <view class="result-meta-card">
        <text class="result-meta-label">豆子</text>
        <text class="result-meta-value">{{resultBeadCount}} 颗</text>
      </view>
    </view>

    <view wx:if="{{usage.length}}" class="result-usage-section">
      <view class="panel-heading usage-heading">
        <text class="panel-title">色号统计</text>
        <text class="panel-badge">{{usage.length}} 色</text>
      </view>
      <view class="usage-list">
        <view wx:for="{{usage}}" wx:key="beadCode" class="usage-row">
          <view class="swatch" style="background: rgb({{item.beadRgb[0]}}, {{item.beadRgb[1]}}, {{item.beadRgb[2]}});"></view>
          <text class="usage-code">{{item.beadCode}}</text>
          <text class="usage-name">{{item.beadName}}</text>
          <text class="usage-count">{{item.count}}</text>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{isEditingMode}}" class="pattern-editor-fullscreen" catchwheel="onEditorWheel">
    <view class="editor-topbar">
      <view class="editor-title-group">
        <text class="editor-title">修改图纸</text>
        <text class="editor-subtitle">{{result.widthCells}} x {{result.heightCells}} - {{editorStatusText}}</text>
      </view>
      <button size="mini" class="editor-close" bindtap="toggleEditingMode">完成</button>
    </view>

    <view class="editor-tool-panel">
      <view class="editor-tool-row">
        <button size="mini" class="editor-tool {{editorTool === 'pan' ? 'active' : ''}}" data-tool="pan" bindtap="onEditorToolTap">移动</button>
        <button size="mini" class="editor-tool {{editorTool === 'point' ? 'active' : ''}}" data-tool="point" bindtap="onEditorToolTap">单点</button>
        <button size="mini" class="editor-tool {{editorTool === 'paint' ? 'active' : ''}}" data-tool="paint" bindtap="onEditorToolTap">连涂</button>
        <button size="mini" class="editor-tool {{editorTool === 'picker' ? 'active' : ''}}" data-tool="picker" bindtap="onEditorToolTap">吸色</button>
        <button size="mini" class="editor-tool {{editorTool === 'fill' ? 'active' : ''}}" data-tool="fill" bindtap="onEditorToolTap">填充</button>
      </view>
      <view class="editor-tool-row secondary">
        <button size="mini" class="editor-tool" bindtap="undoEditorChange" disabled="{{!editorUndoCount}}">撤销</button>
        <button size="mini" class="editor-tool" bindtap="redoEditorChange" disabled="{{!editorRedoCount}}">重做</button>
        <button size="mini" class="editor-tool" bindtap="editorZoomOut">-</button>
        <button size="mini" class="editor-tool" bindtap="resetEditorView">{{editorScaleText}}</button>
        <button size="mini" class="editor-tool" bindtap="editorZoomIn">+</button>
      </view>
    </view>

    <view class="editor-canvas-frame" catchwheel="onEditorWheel">
      <canvas
        class="editor-pattern-canvas"
        type="2d"
        id="editorPatternCanvas"
        style="width: {{editorCanvasCssWidth}}px; height: {{editorCanvasCssHeight}}px;"
        disable-scroll="true"
        catchtouchstart="onEditorCanvasTouchStart"
        catchtouchmove="onEditorCanvasTouchMove"
        catchtouchend="onEditorCanvasTouchEnd"
        catchtouchcancel="onEditorCanvasTouchEnd"
      ></canvas>
    </view>

    <view class="editor-color-panel">
      <view class="edit-popover-head">
        <view class="edit-title-group">
          <text class="edit-title">调色盘</text>
          <text class="edit-current">{{activeEditColorText}}</text>
        </view>
        <view class="edit-head-actions">
          <button size="mini" class="edit-close" bindtap="closeEditPopover">清除</button>
        </view>
      </view>

      <view wx:if="{{selectedEditCellText}}" class="edit-batch-status">
        <text>格子</text>
        <text>{{selectedEditCellText}}</text>
      </view>

      <view wx:if="{{replaceTargetCode}}" class="edit-replace-banner">
        <text>将色号 {{replaceTargetCode}} 替换为：</text>
        <button size="mini" class="edit-replace-cancel" bindtap="cancelReplaceColor">取消</button>
      </view>

      <view class="edit-candidate-section">
        <view class="edit-section-head">
          <text class="edit-section-title">已用色号</text>
          <text class="edit-section-note">点击选色，长按替换</text>
        </view>
        <scroll-view class="edit-candidate-strip" scroll-x="true" enhanced="true" show-scrollbar="false" scroll-into-view="{{candidateScrollInto}}" scroll-with-animation="true">
          <button
            wx:for="{{editCandidateColors}}"
            wx:key="code"
            id="cand-{{item.code}}"
            size="mini"
            class="edit-candidate-chip {{activeEditColor && activeEditColor.code === item.code ? 'active' : ''}} {{replaceTargetCode === item.code ? 'replace-target' : ''}}"
            data-code="{{item.code}}"
            bindtap="{{replaceTargetCode ? 'confirmReplaceColor' : 'selectActiveEditColor'}}"
            bindlongpress="startReplaceColor"
          >
            <view class="edit-candidate-swatch" style="background: rgb({{item.rgb[0]}}, {{item.rgb[1]}}, {{item.rgb[2]}});"></view>
            <view class="edit-candidate-text">
              <text class="edit-candidate-code">{{item.code}}</text>
              <text class="edit-candidate-count">{{item.countLabel}}</text>
              <text class="edit-candidate-focus" catchtap="highlightUsageColor" data-code="{{item.code}}">高亮</text>
            </view>
          </button>
        </scroll-view>
      </view>

      <view class="edit-palette-dropdown">
        <button size="mini" class="edit-dropdown-toggle" bindtap="toggleEditPaletteDropdown">
          <text wx:if="{{editPaletteDropdownOpen}}">关闭色盘</text>
          <text wx:else>全部色号</text>
          <text wx:if="{{editPaletteDropdownOpen}}" class="edit-dropdown-state">收起</text>
          <text wx:else class="edit-dropdown-state">展开</text>
        </button>
        <view wx:if="{{editPaletteDropdownOpen}}" class="edit-dropdown-list">
          <input class="edit-search" placeholder="搜索色号或名称" value="{{editSearchQuery}}" bindinput="onEditSearchInput" />
          <scroll-view class="edit-search-list" scroll-y="true" enhanced="true" show-scrollbar="true">
            <button
              wx:for="{{editSearchResults}}"
              wx:key="code"
              size="mini"
              class="edit-search-row"
              data-code="{{item.code}}"
              bindtap="{{replaceTargetCode ? 'confirmReplaceColor' : 'selectActiveEditColor'}}"
            >
              <view class="edit-swatch" style="background: rgb({{item.rgb[0]}}, {{item.rgb[1]}}, {{item.rgb[2]}});"></view>
              <text class="edit-search-code">{{item.code}}</text>
            </button>
          </scroll-view>
        </view>
      </view>
    </view>
  </view>
</view>





